diff --git a/prj/v0.94/rtl/rp_e1_tag.sv b/prj/v0.94/rtl/rp_e1_tag.sv
new file mode 100644
--- /dev/null
+++ b/prj/v0.94/rtl/rp_e1_tag.sv
@@ -0,0 +1,37 @@
+`timescale 1ns/1ps
+// RTQLM: atomic {ADC14, E1} records, on the ADC clock. No software timestamps.
+// Word bits: [13:0] signed ADC counts, [14] E1, [15] format marker (1).
+// Control: bit 0 enable (handled by scope); bit 1 diagnostic pattern;
+// bits [14:8] extra GPIO history cycles. Default tap 5 gives seven clock
+// edges from the input sample through meta/sync/history. Physical ADC/input
+// path skew must be measured separately before claiming aperture alignment.
+module rp_e1_tag (
+    input  logic        clk,
+    input  logic        rstn,
+    input  logic        e1_i,
+    input  logic [13:0] adc_a_i,
+    input  logic [13:0] adc_b_i,
+    input  logic [31:0] control_i,
+    output logic [15:0] word_a_o,
+    output logic [15:0] word_b_o
+);
+    (* ASYNC_REG = "TRUE" *) logic e1_meta, e1_sync;
+    logic [127:0] history;
+    logic [13:0] counter;
+    always_ff @(posedge clk) begin
+        if (!rstn) begin
+            e1_meta <= 0;
+            e1_sync <= 0;
+            history <= '0;
+            counter <= '0;
+        end else begin
+            e1_meta <= e1_i;
+            e1_sync <= e1_meta;
+            history <= {history[126:0], e1_sync};
+            counter <= counter + 1'b1;
+        end
+    end
+    wire e1 = control_i[1] ? counter[5] : history[control_i[14:8]];
+    assign word_a_o = {1'b1, e1, control_i[1] ? counter : adc_a_i};
+    assign word_b_o = {1'b1, e1, control_i[1] ? ~counter : adc_b_i};
+endmodule
diff --git a/prj/v0.94/rtl/rp_e1_fast_add.sv b/prj/v0.94/rtl/rp_e1_fast_add.sv
new file mode 100644
--- /dev/null
+++ b/prj/v0.94/rtl/rp_e1_fast_add.sv
@@ -0,0 +1,22 @@
+`timescale 1ns/1ps
+// Carry-select blocks with short carry lookahead for the extended ASG pointer.
+module rp_e1_fast_add #(parameter int W=63) (
+    input wire [W-1:0] a, b,
+    output wire [W-1:0] sum
+);
+    localparam int N=(W+15)/16;
+    localparam int PW=N*16;
+    wire [PW-1:0] aa={{(PW-W){1'b0}},a};
+    wire [PW-1:0] bb={{(PW-W){1'b0}},b};
+    wire [PW-1:0] result;
+    wire [N:0] carry;
+    assign carry[0]=1'b0;
+    for (genvar i=0;i<N;i++) begin: block_add
+        wire [16:0] s0={1'b0,aa[i*16+:16]}+{1'b0,bb[i*16+:16]};
+        wire [15:0] s1=aa[i*16+:16]+bb[i*16+:16]+16'd1;
+        wire propagate=&(aa[i*16+:16]^bb[i*16+:16]);
+        assign carry[i+1]=s0[16] | (propagate & carry[i]);
+        assign result[i*16+:16]=carry[i] ? s1 : s0[15:0];
+    end
+    assign sum=result[W-1:0];
+endmodule
