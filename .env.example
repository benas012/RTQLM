QL_BIND_HOST=127.0.0.1
QL_BIND_PORT=8080
QL_DATA_DIR=data
QL_LOG_DIR=logs
QL_INTERNAL_QUEUE_CAPACITY=16
QL_CLIENT_QUEUE_CAPACITY=4
QL_RECONNECT_INITIAL_SECONDS=1
QL_RECONNECT_MAXIMUM_SECONDS=10
QL_STREAMING_MODULE_PATH=
QL_AUTO_START_STREAMING_APP=true
QL_STREAMING_APP_STARTUP_DELAY_SECONDS=6
QL_LOG_LEVEL=INFO
QL_AUTO_CONNECT=false
QL_AUTO_START=false
QL_SHUTDOWN_TIMEOUT_SECONDS=10
# Enable after installing the native processor on the selected boards.
QL_NATIVE_NULLIFIER_ENABLED=false
QL_NATIVE_NULLIFIER_HOSTS=[]
QL_NATIVE_NULLIFIER_EXECUTABLE=/root/rtqlm-nullifiers/current/build/rp-nullifierd
QL_NATIVE_NULLIFIER_PORT=18902
# Buffered ARM commands/results and optional raw ADC transfer use direct TCP.
QL_BUFFERED_TRANSPORT=tcp
QL_BUFFERED_BINARY_PORT=18903
# Set a tagged readout only on a full-rate board running the custom E1 FPGA.
# e1_tile64x2 captures the complete record and masks E1 LOW intervals in C.
QL_BUFFERED_ARM_READOUT=ram_copy
# Use all to send waveform previews, quadratures, and nullifier amplitudes too.
QL_BUFFERED_DISPLAY=variances
# Optional SSH settings for a board with a separately pinned host key.
# QL_BUFFERED_SSH_KNOWN_HOSTS=fpga/e1_sync/known_hosts
# Supply QL_BUFFERED_SSH_PASSWORD through the launch environment if needed.
QL_BUFFERED_BOARD_EXECUTABLE=/root/rtqlm-nullifiers/current/build/rp-buffered-board
# Check the C worker on connection and build/install it when absent.
QL_NATIVE_NULLIFIER_AUTO_INSTALL=true
# Optional SSH password for slow external pin polling; keys are used otherwise.
# QL_TRIGGER_SSH_PASSWORD=
